<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Allows plain-HTTP calls to a locally-run backend. DEBUG ONLY: this manifest is merged into
         debug builds and never into release ones, so a shipped APK still refuses cleartext.
         See res/xml/network_security_config.xml. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
