# FitCheck — Flutter app configuration.
#
#   cp .env.example .env
#
# Then `flutter run` needs no arguments.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE IS BUNDLED INTO THE APP.
#
# flutter_dotenv loads .env as a Flutter asset, so its contents ship inside the
# APK/IPA and can be extracted by anyone who installs the app. Every value below
# is public by design and safe to ship.
#
# NEVER put these here — the app refuses to launch if it finds one:
#   SUPABASE_SERVICE_ROLE_KEY   bypasses every RLS policy in migrations 002-007
#   SUPABASE_JWT_SECRET         lets the holder mint a valid token for any user
#   GEMINI_API_KEY              billable, and nothing in the app calls Gemini
#
# Those belong in backend/.env, read only by the Python service.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable.
# Public by design: it grants nothing on its own, because every table is
# protected by Row Level Security.
SUPABASE_ANON_KEY=

# Where the Python service is reachable.
#
#   Android emulator          http://10.0.2.2:8000
#   iOS simulator / desktop   http://localhost:8000
#   Physical Android device   http://localhost:8000, with a tunnel:
#                                 adb reverse tcp:8000 tcp:8000
#
# The tunnel is preferable to pointing at your machine's LAN IP: it needs no
# firewall rule, and it does not break when DHCP hands you a different address.
# Re-run it after each device reconnect. See supabase/SETUP.md §2.
BACKEND_URL=http://localhost:8000
