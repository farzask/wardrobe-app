# Copy to .env at the REPO ROOT (not here) and fill in. .env is gitignored.
# See supabase/SETUP.md §2.

SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design and protected by RLS. Safe in the mobile app and here.
SUPABASE_ANON_KEY=

# Dashboard → Settings → API → JWT Settings → JWT Secret.
# Used only to VERIFY incoming tokens; it does not grant access to anything.
SUPABASE_JWT_SECRET=

# https://aistudio.google.com/apikey
# NOTE: on the FREE tier Google may retain submitted images to improve its products and human
# reviewers may see them. This is a recorded, deliberate choice — see skills/README.md decision #5.
# A billing-enabled key removes that retention; at this app's scale it costs a few dollars total.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# There is deliberately NO SUPABASE_SERVICE_ROLE_KEY here. This service forwards the caller's own
# JWT so RLS applies to it too. See the design note at the top of app/config.py.
