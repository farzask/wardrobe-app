# FitCheck backend configuration.
#
#   cp backend/.env.example backend/.env
#
# Loaded automatically by app/config.py on startup.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE IS SERVER-SIDE ONLY. It is never bundled into the app.
#
# Keep it separate from the Flutter .env at the repo root, which IS bundled into
# the app and readable by anyone who installs it.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project-ref.supabase.co

# Same public key the app uses. This service forwards the CALLER'S JWT alongside
# it, so Supabase applies the same RLS policies to the backend that it applies to
# the phone — a query that forgets a user_id filter returns nothing instead of
# leaking. See the design note at the top of app/config.py.
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → JWT Settings → JWT Secret.
# SECRET. Used only to VERIFY incoming tokens — but anyone holding it can also
# SIGN one for any account, so it must never reach a client build.
SUPABASE_JWT_SECRET=

# https://aistudio.google.com/apikey
# SECRET, and billable.
#
# NOTE: on the FREE tier Google may retain submitted images to improve its
# products, and human reviewers may see them. That is a deliberate, recorded
# choice — see decision #5 in skills/README.md — and the in-app copy discloses
# it. A billing-enabled key removes the retention; at this app's scale it costs
# a few dollars for the app's entire life.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# There is deliberately NO SUPABASE_SERVICE_ROLE_KEY. It bypasses every RLS
# policy, and this service is built so it never needs one.
